{
  "name": "greg",
  "description": "OpenClaw-like personal assistant",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "greg": "bin/greg.ts"
  },
  "scripts": {
    "gateway": "pm2 start \"bun run gateway/index.ts\" --name greg:gateway --no-autorestart",
    "gateway:stop": "pm2 delete greg:gateway",
    "gateway:restart": "pm2 restart greg:gateway",
    "gateway:logs": "pm2 logs greg:gateway",
    "gateway:tools": "bun run scripts/tools-cli.ts",
    "guard:test": "bun run agent/Agent/tools/utilities/guard/tests/guard.test.ts",
    "test": "bun test",
    "test:sdk": "bun test gateway/sdk/tests/sdk.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.76.0",
    "@clack/prompts": "^1.0.1",
    "@google/genai": "^1.43.0",
    "@grammyjs/files": "^1.2.0",
    "@mariozechner/pi-agent-core": "^0.55.3",
    "@mariozechner/pi-ai": "^0.55.3",
    "@mariozechner/pi-coding-agent": "^0.57.1",
    "@mozilla/readability": "^0.6.0",
    "@notionhq/client": "^5.11.0",
    "@tobilu/qmd": "^1.0.7",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.6.2",
    "commander": "^12.0.0",
    "cron": "^4.4.0",
    "elevenlabs": "^1.59.0",
    "execa": "^9.6.1",
    "fluent-ffmpeg": "^2.1.3",
    "grammy": "^1.40.0",
    "gray-matter": "^4.0.3",
    "image-js": "^1.4.0",
    "jsdom": "^25.0.0",
    "minimatch": "^10.2.4",
    "node-html-markdown": "^1.0.0",
    "node-llama-cpp": "^3.16.2",
    "openai": "^6.25.0",
    "picocolors": "^1.1.1",
    "pm2": "^6.0.14",
    "telegram-markdown-v2": "^0.0.4",
    "ws": "^8.18.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.1.14",
    "@types/chrome-remote-interface": "^0.31.14",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.2.3",
    "@types/ws": "^8.5.12",
    "eslint": "^10.0.3",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
