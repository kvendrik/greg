{
  "name": "greg",
  "description": "OpenClaw-like personal assistant",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "greg": "bin/greg.ts"
  },
  "scripts": {
    "agent": "bun run agent/index.ts",
    "agent:caffeinate": "caffeinate -i bun run agent",
    "agent:memory:index": "bun run qmd update --collection agent-chats && bun run qmd embed --collection agent-chats",
    "clients:cli": "bun run clients/cli.ts",
    "clients:telegram": "bun run clients/telegram/cli.ts",
    "clients:telegram:send-message": "bun run clients/telegram/send-message.ts",
    "jobs": "bun run scripts/jobs.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.76.0",
    "@clack/prompts": "^1.0.1",
    "@google/genai": "^1.43.0",
    "@grammyjs/files": "^1.2.0",
    "@mariozechner/pi-agent-core": "^0.55.3",
    "@mariozechner/pi-ai": "^0.55.3",
    "@notionhq/client": "^5.11.0",
    "@tobilu/qmd": "^1.0.7",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.6.2",
    "commander": "^12.0.0",
    "cron": "^4.4.0",
    "execa": "^9.6.1",
    "fluent-ffmpeg": "^2.1.3",
    "grammy": "^1.40.0",
    "gray-matter": "^4.0.3",
    "image-js": "^1.4.0",
    "node-llama-cpp": "^3.16.2",
    "openai": "^6.25.0",
    "picocolors": "^1.1.1",
    "node-html-markdown": "^1.0.0",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^25.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/chrome-remote-interface": "^0.31.14",
    "@types/node": "^25.2.3",
    "prettier": "^3.4.2"
  }
}
